{
  "expo": {
    "name": "Relay Link",
    "slug": "relay-link",
    "version": "0.1.0",
    "scheme": "relay-link",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.relaylink.mobile",
      "permissions": [],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": ["expo-router", "expo-font", "expo-dev-client"],
    "web": { "bundler": "metro", "output": "static" }
  }
}
