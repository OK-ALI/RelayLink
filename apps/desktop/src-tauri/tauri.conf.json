{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay Link",
  "version": "0.1.0",
  "identifier": "com.relaylink.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Relay Link — Foundation",
        "width": 1280,
        "height": 940,
        "minWidth": 760,
        "minHeight": 620
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": { "active": false }
}
